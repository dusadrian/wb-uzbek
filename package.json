{
  "name": "crm-uzbek",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint -c .eslintrc --ext .ts ./src",
    "tail": "npx tailwindcss -i ./src/assets/main.css -o ./dist/main.css --watch",
    "start": "npm run build && electron ./dist/main.js",
    "dist": "npm run build && electron-builder",
    "pack": "npm run build && electron-builder --dir"
  },
  "author": "CRM Uzbek",
  "license": "UNLICENSED",
  "main": "./dist/main.js",
  "build": {
    "appId": "crm-uzbek",
    "productName": "CRM",
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "directories": {
      "output": "build/output"
    },
    "extraResources": [
      {
        "from": "src/database/uzbek.duckdb",
        "to": "uzbek.duckdb"
      },
      {
        "from": "src/assets/",
        "to": "assets"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "legalTrademarks": "MIT Licence",
      "target": {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@tailwindcss/forms": "^0.5.10",
    "@types/i18n": "^0.13.12",
    "@types/jquery": "^3.5.33",
    "@types/jqueryui": "^1.12.24",
    "@types/lodash": "^4.17.20",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^39.1.1",
    "electron-builder": "^26.1.0",
    "eslint": "^9.39.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "datatables.net": "^2.3.4",
    "datatables.net-dt": "^2.3.4",
    "datatables.net-responsive-dt": "^3.0.7",
    "duckdb": "^1.4.1",
    "eta": "^4.0.1",
    "flatpickr": "^4.6.13",
    "i18n": "^0.15.3",
    "jquery-ui": "^1.14.1",
    "jquery-ui-dist": "^1.13.3",
    "lodash": "^4.17.21",
    "tippy.js": "^6.3.7",
    "uuid": "^13.0.0"
  },
  "postinstall": "electron-builder install-app-deps",
  "engines": {
    "node": ">=22.12.0"
  }
}
